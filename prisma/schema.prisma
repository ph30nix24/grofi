model Lead {
  id               String   @id @default(cuid())
  formType         String   @default("Website Form")
  formTitle        String?
  name             String?
  phone            String?
  email            String?
  service          String?
  status           String   @default("NEW")
  sourcePage       String?
  consentTimestamp DateTime @default(now())
  payload          Json?
  emailSent        Boolean  @default(false)
  emailId          String?
  emailError       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([phone])
  @@index([email])
  @@index([status])
  @@index([createdAt])
}