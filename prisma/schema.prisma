generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model CreditCard {
  id          String   @id 
  name        String
  issuer      String
  logo        String
  cardImage   String?
  network     String
  category    String[]   // e.g. ["cashback", "travel"]
  description String
  categoryLabel String
  badge       String
  popularRank Int?

  joiningFee  String
  annualFee   String
  feeWaiver   String
  forexMarkup String

  rewardRate  Json     // { headline, base, accelerated, rewardCurrency, pointValue }
  loungeAccess Json    // { domestic, international, spendCondition? }
  eligibility Json     // { minIncome, minCreditScore, employmentType }

  welcomeBenefits String[]
  keyHighlights   String[]
  pros            String[]
  cons            String[]

  bestFor           String
  editorialVerdict  String

  cardMetaData      cardMetaData?  

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model cardMetaData {
  id                  String     @id @default(cuid())
  creditCardId        String     @unique    
  title               String
  creditCard          CreditCard @relation(fields: [creditCardId], references: [id])
  description         String
  keywords            String[]

  openGraphTitle      String
  openGraphDesc       String
  imageUrl            String
  imageAlt            String

  twitterTitle        String
  twitterDesc         String
}

model BankFAQS {
  id  String   @id @default(cuid())
  question  String
  answer   String
  bank   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}


model PersonalLoanLender {
  id       String  @id @default(cuid())
  name     String
  logo     String
  tagline  String
  bankType String? 

  interestRate   Json?

  startingEmiPerLakh Float
  maxAmount          String
  maxAmountNum       Float
  tenure             String
  tenureMonths       Int?
  processingFee      String
  processingFeePercent Float?
  disbursalTime      String
  foreclosureCharges String?
  lockInPeriod       String?

  badge      String?
  badgeColor String?
  category String[] 

  minCreditScore Int
  minIncome      String
  features       String[]
  recommendedFor String

  rating      Float?
  reviewCount String?
  overview    String? @db.Text

  pros String[]
  cons String[]

  aprRange       String?
  partPrepayment String?
  bounceCharges  String?
  stampDuty      String?
  aliases        String[]

  eligibilityDetails  Json?

  documentChecklist   Json?

  customFaqs Json?

  title          String
  description    String
  keywords       String[]
  openGraphTitle String
  openGraphDesc  String
  twitterTitle   String
  twitterDesc    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessLoanData {
  id                String  @id
  name              String
  logo              String
  tagline           String
  bankType          String
  interestRate      Json
  startingEmiPerLakh      Int
  maxAmount   String
  maxAmountNum    Int
  tenure    String
  tenureMonths    Int
  processingFee    String
  processingFeePercent    Float
  collateralType    String
  disbursalTime   String
  foreclosureCharges    String
  minTurnover    String
  minVintage    String
  minCibilScore   Int
  badge   String
  badgeColor    String?
  category    String[]
  features    String[]
  recommendedFor    String
  rating    Float
  reviewCount   String
  faqs    Json[]
  title   String
  description   String
  keywords    String[]
  openGraphTitle    String
  openGraphDesc   String
  twitterTitle    String
  twitterDesc   String
}

model HomeLoanData {
  id    String    @id
  name    String
  logo    String
  tagline   String
  bankType    String
  interestRate    Json
  startingEmiPerLakh20Yr    Int
  startingEmiPerLakh30Yr    Int
  maxAmount   String
  maxAmountNum    Int
  maxTenure    String
  tenureYears   Int
  processingFee   String
  processingFeePercent    Float
  maxLtv    String
  womenConcession   String
  overdraftScheme   String?
  foreclosureCharges    String
  category    String[]
  minCreditScore    Int
  minIncome   String
  features    String[]
  pros    String[]
  recommendedFor    String
  rating    Float
  reviewCount   String
  badge   String?
  badgeColor    String?

  title   String
  description   String
  keywords    String[]  
  openGraphTitle    String
  openGraphDesc   String
  twitterTitle    String
  twitterDesc   String

  faqs    Json[]
}